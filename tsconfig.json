{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "platforms"]
}